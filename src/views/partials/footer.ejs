  <script>
    // Confirmação de exclusão via JavaScript
    document.querySelectorAll('form[data-confirm]').forEach(form => {
      form.addEventListener('submit', function(e) {
        const mensagem = this.dataset.confirm || 'Tem certeza que deseja excluir?';
        if (!confirm(mensagem)) {
          e.preventDefault();
        }
      });
    });
  </script>
